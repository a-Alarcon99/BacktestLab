# --- Supabase Postgres ---
# Transaction pooler (runtime, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection (Drizzle migrations, port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Better Auth ---
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backtest engine (server-side only; same INTERNAL_API_KEY in apps/api) ---
# API_URL=http://127.0.0.1:8000
# INTERNAL_API_KEY=         # openssl rand -hex 32

# --- Abuse / cost protection (see ../../SECURITY.md) ---
# TRUSTED_PROXY_HOPS=1      # proxies in front of the app (1 on Vercel); unset = per-IP limits off
# MAIL_DAILY_LIMIT=300      # verification emails per rolling 24 h (global, counted in the DB)
# DB_POOL_MAX=5             # postgres connections per server instance
# Optional shared rate-limit store (Upstash Redis, REST API). Unset = per-instance limits only.
# Never prefix these with NEXT_PUBLIC_: the token must stay on the server.
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
