# Supabase Postgres (transaction pooler, port 6543). Schema is owned by Drizzle in apps/web.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Market data. Binance needs no key; switch to https://data-api.binance.vision if api.binance.com is geo-blocked.
BINANCE_BASE_URL=https://api.binance.com
# Free CoinGecko demo key (market cap + rank): https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# false = never call Binance/CoinGecko, serve only stored data (kept fresh by `python -m app.sync`,
# see ../../docs/03-datos-de-mercado.md, Parte D). Never set it to false where the sync runs.
# PROVIDER_FETCH_ENABLED=true
# Seconds between rounds of `python -m app.sync`
# SYNC_INTERVAL_SECONDS=15
# Render, while the sync runs on your PC: 120 so the API doesn't refresh quotes before the sync does
# QUOTE_TTL_SECONDS=30

# Candle history: Parquet files in Cloudflare R2 (S3 API). The API only reads; `python -m app.ingest`
# writes. Without R2_ENDPOINT, CANDLE_LOCAL_DIR (same layout, a local folder) is used instead.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=backtestlab-candles
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CANDLE_LOCAL_DIR=
# CANDLE_CACHE_DIR=/tmp/backtestlab-candles   # disk cache of the files already read
# CANDLE_CACHE_MAX_MB=300

# --- Abuse / cost protection (defaults shown; see ../../SECURITY.md) ---
# DOCS_ENABLED=false                      # hide /docs and /openapi.json in production
TRUSTED_PROXY_HOPS=1                    # reverse proxies in front of the API (0 = ignore X-Forwarded-For)
# RATE_LIMIT_BACKTEST_PER_MINUTE=6
# RATE_LIMIT_BACKTEST_PER_HOUR=60
# RATE_LIMIT_BACKTEST_GLOBAL_PER_MINUTE=60
# PROVIDER_CALLS_PER_MINUTE=300
# MAX_CONCURRENT_BACKTESTS=2
# MAX_BACKTEST_CANDLES=100000
# DB_POOL_MAX_SIZE=8
